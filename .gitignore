# ============================================================
# Oculs.io — .gitignore
# ============================================================

# ---- Dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js build output ----
/.next/
/out/
/build
/dist

# ---- Environment variables — NEVER commit these ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# Allow .env.example to be committed
!.env.example

# ---- Vercel ----
.vercel

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Testing ----
/coverage
.nyc_output/
playwright-report/
test-results/

# ---- OS artifacts ----
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# ---- Editors ----
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# ---- AWS / Cloud credentials ----
.aws/
*.key
*.crt
credentials

# ---- Drizzle ORM migrations (generated) ----
drizzle/

# ---- Misc ----
*.tgz
.cache/
.turbo/