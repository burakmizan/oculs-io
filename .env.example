# ============================================================
# Oculs.io — Environment Variable Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ------------------------------------------------------------
# AWS Aurora PostgreSQL (primary database)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# ------------------------------------------------------------
DATABASE_URL="postgresql://oculs_user:CHANGE_ME@your-aurora-cluster.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/oculs_db?sslmode=require"

# ------------------------------------------------------------
# AWS Credentials (used for Aurora IAM auth & S3 report storage)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"

# AWS Aurora cluster ARN (for Data API / RDS IAM auth)
AWS_AURORA_CLUSTER_ARN="arn:aws:rds:us-east-1:123456789012:cluster:oculs-aurora-cluster"
AWS_AURORA_SECRET_ARN="arn:aws:secretsmanager:us-east-1:123456789012:secret:oculs-db-secret"

# ------------------------------------------------------------
# AI — Google Gemini
# ------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYOUR_GEMINI_API_KEY_HERE"

# Gemini model to use for vulnerability analysis
GEMINI_MODEL="gemini-1.5-pro"

# ------------------------------------------------------------
# GitHub Integration (for triggering Actions workflows)
# ------------------------------------------------------------
GITHUB_TOKEN="ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
GITHUB_WEBHOOK_SECRET="YOUR_RANDOM_WEBHOOK_SECRET_STRING"

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET="YOUR_AUTH_SECRET_32_CHARS_MIN"
AUTH_URL="http://localhost:3000"

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# ------------------------------------------------------------
# Feature Flags (optional)
# ------------------------------------------------------------
ENABLE_AI_AUTOFIX="true"
SCAN_TIMEOUT_SECONDS="300"
